{
  "name": "@mboa/host-layer",
  "version": "1.0.0",
  "private": true,
  "description": "Mini App Runtime: Redux provider, persistence, auth bootstrap, runtime loader and lifecycle.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check",
    "publish:local": "yalc publish --private",
    "push:local": "yalc push --private"
  },
  "peerDependencies": {
    "@mboa/core": "^1.0.0",
    "@reduxjs/toolkit": ">=2",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-redux": ">=9",
    "redux-persist": ">=6"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@mboa/core": "file:.yalc/@mboa/core",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.0",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0",
    "yalc": "^1.0.0-pre.53"
  }
}
